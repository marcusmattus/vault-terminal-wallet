{
  "expo": {
    "name": "Vault Terminal Wallet",
    "slug": "vault-terminal-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marcusmattus.vaultterminalwallet",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vault Terminal Wallet uses Face ID to unlock your wallet and authorize transactions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marcusmattus.vaultterminalwallet",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vault Terminal Wallet uses Face ID to unlock your wallet and authorize transactions."
        }
      ]
    ]
  }
}
